{
  "manifest_version": 3,
  "name": "מתקן שגיאות כתיב - SpellFixer",
  "short_name": "SpellFixer",
  "version": "1.0.0",
  "description": "מזהה שגיאות כתיב בכל אתר - בשדות טקסט ובתוכן הדף - ומתקן אותן בלחיצה. עברית, אנגלית ועוד.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "מתקן שגיאות כתיב",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.languagetool.org/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/dictionary.js", "lib/checker.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fix-field": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "תקן את כל השגיאות בשדה הפעיל"
    },
    "scan-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "סרוק את הדף לשגיאות כתיב"
    }
  }
}
